{
  "version": 2,
  "builds": [
    {
      "src": "api/tb-token.js",
      "use": "@vercel/node"
    },
    {
      "src": "(.*)",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/tb-token",
      "dest": "api/tb-token.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
